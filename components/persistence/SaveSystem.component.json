{
  "id": "persistence.save_system",
  "name": "Save System",
  "category": "persistence",
  "description": "Serializes a player's game state into a saveable snapshot on an interval or on declared state-change triggers, including completed build, specialization, mastery, quest, dialogue, elite-assignment, encounter, telegraph, world-flag, inventory, and journal changes.",
  "version": "0.2.4",
  "platform": [
    "roblox",
    "godot",
    "unity",
    "web",
    "agnostic"
  ],
  "implementations": [
    {
      "target": "canvas2d",
      "status": "external",
      "module": null,
      "note": "Implemented in the consuming application; not verifiable from this repository."
    },
    {
      "target": "godot",
      "status": "unmapped",
      "module": null
    },
    {
      "target": "roblox",
      "status": "scaffold",
      "module": "roblox-adapters/persistence.save_system.adapter.lua"
    },
    {
      "target": "unity",
      "status": "unmapped",
      "module": null
    }
  ],
  "inputs": [
    {
      "name": "autosaveIntervalSeconds",
      "type": "number",
      "required": false,
      "default": 120
    }
  ],
  "outputs": [
    {
      "name": "lastSavedAt",
      "type": "number"
    }
  ],
  "events": {
    "emits": [
      "persistence.saved",
      "persistence.saveFailed"
    ],
    "listensTo": [
      "inventory.itemAdded",
      "economy.earned",
      "progression.leveledUp",
      "progression.skillRankChanged",
      "progression.abilityLoadoutChanged",
      "progression.buildRespecCompleted",
      "progression.questStarted",
      "progression.questStageChanged",
      "progression.questCompleted",
      "progression.questFailed",
      "world.worldFlagChanged",
      "ui.dialogueNodeAdvanced",
      "ui.journalEntryAdded",
      "progression.specializationSelected",
      "progression.masteryXpGained",
      "progression.masteryRankUp",
      "combat.eliteAffixesAssigned",
      "combat.eliteEncounterStarted",
      "combat.eliteWaveStarted",
      "combat.eliteEncounterCompleted",
      "combat.eliteEncounterFailed",
      "combat.eliteEncounterReset",
      "combat.attackTelegraphed",
      "combat.attackCommitted",
      "combat.attackTelegraphCancelled",
      "combat.bossEngaged",
      "combat.bossPhaseChanged",
      "combat.bossEnraged",
      "combat.bossEncounterCompleted",
      "combat.bossEncounterFailed",
      "combat.bossEncounterReset",
      "world.arenaPhaseChanged",
      "world.arenaHazardTelegraphed",
      "world.arenaHazardTriggered",
      "world.arenaHazardsReset"
    ]
  },
  "sinkFor": [
    "persist"
  ],
  "dependencies": [],
  "tags": [
    "save",
    "persistence",
    "state"
  ],
  "sourceModule": "roblox-modular-lib/src/SaveSystem.lua",
  "provenance": "upstream-mapped"
}
