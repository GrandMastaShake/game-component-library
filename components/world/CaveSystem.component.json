{
  "id": "world.cave_system",
  "name": "Cave System",
  "category": "world",
  "description": "Carves underground cave networks and tunnels beneath generated terrain using 3D noise thresholds.",
  "version": "0.1.0",
  "platform": [
    "roblox",
    "godot",
    "unity",
    "agnostic"
  ],
  "implementations": [
    {
      "target": "canvas2d",
      "status": "external",
      "module": null,
      "note": "Implemented in the consuming application; not verifiable from this repository."
    },
    {
      "target": "godot",
      "status": "unmapped",
      "module": null
    },
    {
      "target": "roblox",
      "status": "not-implemented",
      "module": "roblox-modular-lib/src/CaveSystem.lua",
      "note": "Upstream module named; no adapter written."
    },
    {
      "target": "unity",
      "status": "unmapped",
      "module": null
    },
    {
      "target": "webgl",
      "status": "external",
      "module": null,
      "note": "Implemented in the consuming application; not verifiable from this repository."
    }
  ],
  "inputs": [
    {
      "name": "density",
      "type": "number",
      "required": false,
      "default": 0.45
    },
    {
      "name": "minDepth",
      "type": "number",
      "required": false,
      "default": 10
    }
  ],
  "outputs": [
    {
      "name": "caveVoxels",
      "type": "array"
    }
  ],
  "events": {
    "emits": [
      "world.cavesGenerated"
    ],
    "listensTo": [
      "world.terrainGenerated"
    ]
  },
  "dependencies": [
    "world.terrain_generator",
    "world.noise_lib"
  ],
  "tags": [
    "procedural",
    "underground"
  ],
  "sourceModule": "roblox-modular-lib/src/CaveSystem.lua"
}
