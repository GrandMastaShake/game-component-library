{
  "id": "ui.pause_menu",
  "name": "Pause Menu",
  "category": "ui",
  "version": "0.1.0",
  "description": "A modal pause section for resume, settings, restart, and return-to-title flows. The menu owns action presentation, focus restoration, and destructive-action confirmation; the session or simulation owner decides whether time stops, a run resets, or the route changes.",
  "platform": ["agnostic"],
  "implementations": [
    {"target": "canvas2d", "status": "unmapped", "module": null},
    {"target": "webgl", "status": "unmapped", "module": null},
    {"target": "roblox", "status": "unmapped", "module": null},
    {"target": "godot", "status": "unmapped", "module": null},
    {"target": "unity", "status": "unmapped", "module": null}
  ],
  "inputs": [
    {"name": "allowRestart", "type": "boolean", "required": false, "default": true},
    {"name": "allowQuitToTitle", "type": "boolean", "required": false, "default": true},
    {"name": "confirmDestructiveActions", "type": "boolean", "required": false, "default": true},
    {"name": "reducedMotion", "type": "boolean", "required": false, "default": false}
  ],
  "outputs": [
    {"name": "visible", "type": "boolean"},
    {"name": "actions", "type": "array", "description": "Ordered menu actions with enabled and confirmation state."},
    {"name": "focusedAction", "type": "string"},
    {"name": "confirmationAction", "type": "string", "description": "Action awaiting confirmation, or empty."}
  ],
  "events": {
    "emits": ["ui.resumeRequested", "ui.restartRequested", "ui.settingsRequested", "ui.quitToTitleRequested"],
    "listensTo": ["ui.routeChanged", "ui.layoutChanged", "presentation.styleApplied", "input.pause"]
  },
  "dependencies": ["ui.safe_area_layout"],
  "tags": ["ui", "pause", "menu", "focus-management", "accessibility"],
  "provenance": "library-native"
}
