{
  "id": "ui.notification_toast",
  "name": "Notification Toast",
  "category": "ui",
  "description": "Queued, auto-dismissing toast notification contract for achievements, loot, hatch results, and system messages. The Roblox adapter subscribes to normalized requests and delegates rendering to a game-owned UI renderer.",
  "version": "0.3.1",
  "platform": ["roblox", "unity", "web", "agnostic"],
  "inputs": [{"name": "maxVisible", "type": "number", "required": false, "default": 3}, {"name": "displaySeconds", "type": "number", "required": false, "default": 4}],
  "outputs": [{"name": "queueLength", "type": "number"}],
  "events": {"emits": ["ui.notificationShown", "ui.notificationDismissed"], "listensTo": ["inventory.itemGranted", "progression.leveledUp", "economy.earned", "ui.notificationRequested"]},
  "sinkFor": ["notify"],
  "dependencies": [],
  "tags": ["feedback", "presentation"],
  "sourceModule": "roblox-modular-lib/src/NotificationSystem.lua",
  "provenance": "hybrid",
  "implementationPath": "roblox-adapters/ui.notification_toast.adapter.lua"
}
