{
  "id": "ui.title_screen",
  "name": "Title Screen",
  "category": "ui",
  "version": "0.1.0",
  "description": "A game-facing title section with brand artwork slots, new-game and continue actions, settings access, and optional quit. It presents save availability supplied by the host and emits navigation or session requests only; it never loads a save, creates a run, or quits the application itself.",
  "platform": ["agnostic"],
  "implementations": [
    {"target": "canvas2d", "status": "unmapped", "module": null},
    {"target": "webgl", "status": "unmapped", "module": null},
    {"target": "roblox", "status": "unmapped", "module": null},
    {"target": "godot", "status": "unmapped", "module": null},
    {"target": "unity", "status": "unmapped", "module": null}
  ],
  "inputs": [
    {"name": "title", "type": "string", "required": true},
    {"name": "subtitle", "type": "string", "required": false, "default": ""},
    {"name": "continueAvailable", "type": "boolean", "required": false, "default": false},
    {"name": "showQuit", "type": "boolean", "required": false, "default": true},
    {"name": "versionLabel", "type": "string", "required": false, "default": ""},
    {"name": "reducedMotion", "type": "boolean", "required": false, "default": false}
  ],
  "outputs": [
    {"name": "visible", "type": "boolean"},
    {"name": "actions", "type": "array", "description": "Ordered action models as {id, label, enabled, primary, hitRegion}. Disabled Continue remains explainable rather than silently disappearing."},
    {"name": "focusedAction", "type": "string"}
  ],
  "events": {
    "emits": ["ui.newGameRequested", "ui.continueRequested", "ui.settingsRequested", "ui.quitRequested"],
    "listensTo": ["ui.routeChanged", "ui.layoutChanged", "presentation.styleApplied"]
  },
  "dependencies": ["ui.safe_area_layout"],
  "tags": ["ui", "title", "menu", "navigation", "responsive"],
  "provenance": "library-native"
}
