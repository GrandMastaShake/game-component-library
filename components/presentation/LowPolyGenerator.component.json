{
  "id": "presentation.low_poly_generator",
  "name": "Low-Poly Generator",
  "category": "presentation",
  "description": "Procedurally generates simplified low-polygon meshes for props, rocks, trees, and terrain features to keep part counts and rendering cost low.",
  "version": "0.1.0",
  "platform": [
    "roblox",
    "godot",
    "unity",
    "agnostic"
  ],
  "implementations": [
    {
      "target": "canvas2d",
      "status": "external",
      "module": null,
      "note": "Implemented in the consuming application; not verifiable from this repository."
    },
    {
      "target": "godot",
      "status": "unmapped",
      "module": null
    },
    {
      "target": "roblox",
      "status": "not-implemented",
      "module": "roblox-modular-lib/src/LowPolyGenerator.lua",
      "note": "Upstream module named; no adapter written."
    },
    {
      "target": "unity",
      "status": "unmapped",
      "module": null
    }
  ],
  "inputs": [
    {
      "name": "targetFaceCount",
      "type": "number",
      "required": false,
      "default": 200
    },
    {
      "name": "shapeType",
      "type": "string",
      "required": false,
      "default": "rock"
    }
  ],
  "outputs": [
    {
      "name": "meshData",
      "type": "object"
    }
  ],
  "events": {
    "emits": [
      "presentation.meshGenerated"
    ],
    "listensTo": []
  },
  "dependencies": [],
  "tags": [
    "mesh",
    "procedural",
    "performance"
  ],
  "sourceModule": "roblox-modular-lib/src/LowPolyGenerator.lua"
}
