{
  "id": "presentation.audio_system",
  "name": "Audio System",
  "category": "presentation",
  "description": "Centralized sound effect and music playback manager with volume buckets, 3D spatial sound, and crossfade between tracks.",
  "version": "0.1.0",
  "platform": ["roblox", "godot", "unity", "web", "agnostic"],
  "implementations": [
    {"target": "canvas2d", "status": "external", "module": null, "note": "Implemented in the consuming application; not verifiable from this repository."},
    {"target": "godot", "status": "unmapped", "module": null},
    {"target": "roblox", "status": "not-implemented", "module": "roblox-modular-lib/src/AudioSystem.lua", "note": "Upstream module named; no adapter written."},
    {"target": "unity", "status": "unmapped", "module": null}
  ],
  "inputs": [
    {"name": "masterVolume", "type": "number", "required": false, "default": 1.0}
  ],
  "outputs": [
    {"name": "nowPlaying", "type": "string"}
  ],
  "events": {"emits": ["presentation.soundPlayed", "presentation.musicChanged"], "listensTo": ["world.weatherChanged"]},
  "sinkFor": ["impact"],
  "dependencies": [],
  "tags": ["audio", "sfx", "music"],
  "sourceModule": "roblox-modular-lib/src/AudioSystem.lua"
}
