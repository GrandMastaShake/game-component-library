{
  "id": "movement.physics_core",
  "name": "Physics Core",
  "category": "movement",
  "description": "Low-level physics utility for projectile arcs, knockback impulses, and gravity-affected motion used by combat and movement bricks.",
  "version": "0.1.0",
  "platform": [
    "roblox",
    "godot",
    "unity",
    "agnostic"
  ],
  "implementations": [
    {
      "target": "canvas2d",
      "status": "external",
      "module": null,
      "note": "Implemented in the consuming application; not verifiable from this repository."
    },
    {
      "target": "godot",
      "status": "unmapped",
      "module": null
    },
    {
      "target": "roblox",
      "status": "not-implemented",
      "module": "roblox-modular-lib/src/Physics.lua",
      "note": "Upstream module named; no adapter written."
    },
    {
      "target": "unity",
      "status": "unmapped",
      "module": null
    },
    {
      "target": "webgl",
      "status": "external",
      "module": null,
      "note": "Implemented in the consuming application; not verifiable from this repository."
    }
  ],
  "inputs": [
    {
      "name": "gravity",
      "type": "number",
      "required": false,
      "default": 9.8
    }
  ],
  "outputs": [
    {
      "name": "computeTrajectory",
      "type": "function"
    },
    {
      "name": "computeKnockback",
      "type": "function"
    }
  ],
  "events": {
    "emits": [],
    "listensTo": []
  },
  "dependencies": [],
  "tags": [
    "utility",
    "physics",
    "math"
  ],
  "sourceModule": "roblox-modular-lib/src/Physics.lua"
}
