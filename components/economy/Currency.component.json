{
  "id": "economy.currency",
  "name": "Currency",
  "category": "economy",
  "description": "A single spendable currency balance with earn/spend transactions and persistence hooks.",
  "version": "0.1.1",
  "platform": ["roblox", "godot", "unity", "web", "agnostic"],
  "implementations": [
    {"target": "canvas2d", "status": "external", "module": null, "note": "Implemented in the consuming application; not verifiable from this repository."},
    {"target": "godot", "status": "unmapped", "module": null},
    {"target": "roblox", "status": "scaffold", "module": "roblox-adapters/economy.currency.adapter.lua"},
    {"target": "unity", "status": "unmapped", "module": null}
  ],
  "inputs": [
    {"name": "currencyName", "type": "string", "required": false, "default": "Coins"},
    {"name": "startingBalance", "type": "number", "required": false, "default": 0}
  ],
  "outputs": [
    {"name": "balance", "type": "number"}
  ],
  "events": {
    "emits": ["economy.earned", "economy.spent", "economy.insufficientFunds"],
    "listensTo": ["social.tradeCommitted"]
  },
  "sinkFor": ["reward"],
  "dependencies": [],
  "tags": ["currency", "progression"],
  "sourceModule": "roblox-modular-lib/src/CurrencySystem.lua"
}
