{
  "id": "social.trade_window",
  "name": "Trade Window",
  "category": "social",
  "description": "Two-player item and currency trade UI with confirm/cancel, backed by server-authoritative validation via Trade Coordinator.",
  "version": "0.1.1",
  "platform": ["roblox", "web", "agnostic"],
  "implementations": [
    {"target": "canvas2d", "status": "external", "module": null, "note": "Implemented in the consuming application; not verifiable from this repository."},
    {"target": "roblox", "status": "not-implemented", "module": "roblox-modular-lib/src/TradeSystem.lua", "note": "Upstream module named; no adapter written."}
  ],
  "inputs": [
    {"name": "maxItemsPerSide", "type": "number", "required": false, "default": 8}
  ],
  "outputs": [
    {"name": "isOpen", "type": "boolean"},
    {"name": "offerA", "type": "object"},
    {"name": "offerB", "type": "object"}
  ],
  "events": {
    "emits": ["social.tradeOpened", "social.tradeCompleted", "social.tradeCancelled"],
    "listensTo": ["inventory.itemAdded", "social.tradeCommitted", "social.tradeRejected"]
  },
  "dependencies": ["inventory.slotted_bag", "economy.currency", "social.trade_coordinator", "social.trade_remote_handler"],
  "tags": ["multiplayer", "trading"],
  "sourceModule": "roblox-modular-lib/src/TradeSystem.lua"
}
