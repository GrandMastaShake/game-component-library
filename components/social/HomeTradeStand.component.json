{
  "id":"social.home_trade_stand","name":"Home Trade Stand","category":"social","description":"A placeable in-home listing surface for pets/items a player is willing to trade. It exposes browseable listings to visitors and routes an accepted offer into the server-authoritative trade flow.","version":"0.1.0","platform":["roblox","web","agnostic"],
  "inputs":[{"name":"maxListings","type":"number","required":false,"default":12},{"name":"allowVisitorOffers","type":"boolean","required":false,"default":true}],
  "outputs":[{"name":"activeListings","type":"array"},{"name":"visitorCount","type":"number"}],
  "events":{"emits":["social.tradeOpened","social.listingAdded","social.listingRemoved"],"listensTo":["housing.visitorEntered","inventory.itemAdded","social.tradeCommitted","social.tradeRejected"]},
  "dependencies":["housing.home_system","inventory.core_inventory","social.trade_coordinator","social.trade_remote_handler"],"tags":["housing","trading","social","showcase"],"provenance":"library-native"
}
