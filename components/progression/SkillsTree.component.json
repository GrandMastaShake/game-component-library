{
  "id": "progression.skills_tree",
  "name": "Skills Tree",
  "category": "progression",
  "description": "Branching skill tree that unlocks nodes with earned skill points, gated by level requirements.",
  "version": "0.1.0",
  "platform": [
    "roblox",
    "godot",
    "unity",
    "agnostic"
  ],
  "implementations": [
    {
      "target": "canvas2d",
      "status": "external",
      "module": null,
      "note": "Implemented in the consuming application; not verifiable from this repository."
    },
    {
      "target": "godot",
      "status": "unmapped",
      "module": null
    },
    {
      "target": "roblox",
      "status": "not-implemented",
      "module": "roblox-modular-lib/src/Skills.lua",
      "note": "Upstream module named; no adapter written."
    },
    {
      "target": "unity",
      "status": "unmapped",
      "module": null
    }
  ],
  "inputs": [
    {
      "name": "treeDefinition",
      "type": "object",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "unlockedNodes",
      "type": "array"
    },
    {
      "name": "availablePoints",
      "type": "number"
    }
  ],
  "events": {
    "emits": [
      "progression.skillUnlocked"
    ],
    "listensTo": [
      "progression.leveledUp"
    ]
  },
  "dependencies": [
    "progression.xp_leveling"
  ],
  "tags": [
    "skills",
    "unlocks"
  ],
  "sourceModule": "roblox-modular-lib/src/Skills.lua"
}
