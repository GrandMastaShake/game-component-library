{
  "id":"compound.pet_hatching_loop","name":"Pet Hatching Loop","version":"0.2.0","description":"Egg inventory enables a weighted hatch result; a dedicated presenter converts it into a normalized UI notification request; ownership state is marked for persistence.","targetPlatform":"roblox",
  "components":[{"id":"inventory.core_inventory","role":"authoritative egg and pet ownership store","config":{"maxSlots":50}},{"id":"economy.currency","role":"optional hatch-cost balance","config":{"currencyName":"Coins"}},{"id":"pets.egg_hatchery","role":"weighted egg-to-pet outcome resolver","config":{"hatchTable":[]}},{"id":"ui.pet_hatch_presenter","role":"hatch-result to notification bridge","config":{}},{"id":"ui.notification_toast","role":"normalized player feedback","config":{}},{"id":"persistence.save_system","role":"durable ownership snapshot","config":{"autosaveIntervalSeconds":120}}],
  "connections":[{"from":"inventory.core_inventory","event":"inventory.itemAdded","to":"pets.egg_hatchery"},{"from":"pets.egg_hatchery","event":"pets.hatched","to":"ui.pet_hatch_presenter"},{"from":"pets.egg_hatchery","event":"pets.hatched","to":"persistence.save_system"},{"from":"ui.pet_hatch_presenter","event":"ui.notificationRequested","to":"ui.notification_toast"}],
  "criticalComponents":["inventory.core_inventory","pets.egg_hatchery","ui.pet_hatch_presenter","persistence.save_system"],"acceptanceCriteria":["A hatch outcome is selected from a configured weighted table.","A hatch result becomes a normalized player notification request.","A successful hatch marks ownership state for persistence."]
