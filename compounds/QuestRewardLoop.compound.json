{"id":"compound.quest_reward_loop","name":"Quest Reward Loop","version":"0.1.0","description":"Objective progress leads to quest completion, XP/currency reward state, player feedback, and a durable saved snapshot.","targetPlatform":"roblox","components":[{"id":"progression.quest_log","role":"objective and completion tracker","config":{"maxActiveQuests":5}},{"id":"progression.xp_leveling","role":"reward progression","config":{"startingLevel":1}},{"id":"economy.currency","role":"currency reward balance","config":{"currencyName":"Coins"}},{"id":"ui.notification_toast","role":"quest completion feedback","config":{}},{"id":"persistence.save_system","role":"durable quest/reward state","config":{"autosaveIntervalSeconds":120}}],"connections":[{"from":"progression.quest_log","event":"progression.questCompleted","to":"progression.xp_leveling"},{"from":"progression.quest_log","event":"progression.questCompleted","to":"ui.notification_toast"},{"from":"progression.quest_log","event":"progression.questCompleted","to":"persistence.save_system"},{"from":"economy.currency","event":"economy.earned","to":"ui.notification_toast"},{"from":"economy.currency","event":"economy.earned","to":"persistence.save_system"}],"criticalComponents":["progression.quest_log","progression.xp_leveling","economy.currency","persistence.save_system"],"acceptanceCriteria":["Completing a quest updates the quest log exactly once.","Quest completion enters both reward and persistence paths.","Currency rewards generate player-visible feedback.","Reloaded player state retains completed quests and rewards."]}
