{"id":"compound.pet_progression_loop","name":"Pet Progression Loop","version":"0.1.0","description":"A companion progression recipe: pet activity contributes to XP, level gains notify the player, and the resulting progression is saved.","targetPlatform":"roblox","components":[{"id":"pets.pet_companion","role":"active companion","config":{"followDistance":6}},{"id":"movement.basic_walk","role":"player/pet locomotion signal source","config":{"walkSpeed":16}},{"id":"progression.xp_leveling","role":"experience and level state","config":{"startingLevel":1}},{"id":"progression.skills_tree","role":"level-gated unlock path","config":{}},{"id":"ui.notification_toast","role":"player progression feedback","config":{"maxVisible":3}},{"id":"persistence.save_system","role":"durable progression snapshot","config":{"autosaveIntervalSeconds":120}}],"connections":[{"from":"movement.basic_walk","event":"movement.started","to":"pets.pet_companion"},{"from":"progression.xp_leveling","event":"progression.leveledUp","to":"progression.skills_tree"},{"from":"progression.xp_leveling","event":"progression.leveledUp","to":"ui.notification_toast"},{"from":"progression.xp_leveling","event":"progression.leveledUp","to":"persistence.save_system"}],"criticalComponents":["pets.pet_companion","progression.xp_leveling","ui.notification_toast","persistence.save_system"],"acceptanceCriteria":["An equipped companion responds to player movement.","A level gain is visible to the player.","A level gain triggers skill unlock evaluation.","Progression changes are included in persistence state."]}
