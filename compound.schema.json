{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GameComponentCompound",
  "description": "A tested composition of component bricks and event wires. Compounds are reusable game-system recipes, not new runtime modules.",
  "type": "object",
  "required": ["id", "name", "version", "targetPlatform", "components", "connections"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "targetPlatform": {"type": "string"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": {"type": "string", "description": "Referenced component brick id"},
          "role": {"type": "string", "description": "Role this instance performs in the composition"},
          "config": {"type": "object"}
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "event", "to"],
        "properties": {
          "from": {"type": "string", "description": "Source component id"},
          "event": {"type": "string", "description": "Emitted event name"},
          "to": {"type": "string", "description": "Listening component id"},
          "note": {"type": "string"}
        }
      }
    },
    "criticalComponents": {
      "type": "array",
      "items": {"type": "string"}
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
