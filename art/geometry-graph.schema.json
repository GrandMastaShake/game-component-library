{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolyforgeGeometryGraph",
  "description": "Canonical non-destructive POLYFORGE geometry DAG. Stable node and link identities are the editing API; evaluation produces the canonical forge asset consumed by Asset Baker.",
  "type": "object",
  "required": ["format", "version", "id", "name", "nodes", "links", "outputs", "nextIds", "checksum"],
  "additionalProperties": false,
  "properties": {
    "format": {"type": "string", "const": "polyforge.geometry"},
    "version": {"type": "string", "const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "parameters"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^n[0-9]{6}$"},
          "type": {"type": "string", "enum": ["source.generate", "source.asset", "edit.move", "edit.split", "edit.extrudeFace", "edit.deleteFace", "modify.transform", "configure.budgets", "measure.asset", "output.asset"]},
          "parameters": {"type": "object"},
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^l[0-9]{6}$"},
          "from": {"$ref": "#/definitions/endpoint"},
          "to": {"$ref": "#/definitions/endpoint"}
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["asset"],
      "additionalProperties": false,
      "properties": {
        "asset": {"$ref": "#/definitions/endpoint"},
        "stats": {"$ref": "#/definitions/endpoint"}
      }
    },
    "nextIds": {
      "type": "object",
      "required": ["node", "link"],
      "additionalProperties": false,
      "properties": {
        "node": {"type": "integer", "minimum": 0},
        "link": {"type": "integer", "minimum": 0}
      }
    },
    "checksum": {"type": "string", "pattern": "^fnv1a32:[0-9a-f]{8}$"}
  },
  "definitions": {
    "endpoint": {
      "type": "object",
      "required": ["node", "socket"],
      "additionalProperties": false,
      "properties": {
        "node": {"type": "string", "pattern": "^n[0-9]{6}$"},
        "socket": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
